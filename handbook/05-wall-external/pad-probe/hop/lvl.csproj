<Project Sdk="Microsoft.NET.Sdk">
  <!-- hb-tables level-scale harness. Build HSD-Unity first (no Unity needed):
         dotnet build <HSD-Unity>/HSD.Game.csproj -p:OutputPath=<bin>
       then: dotnet build lvl.csproj -p:HsdBin=<bin> -o <out>;  DOTNET_GCgen0size=0x7FFFFFFF dotnet <out>/lvl.dll all <out>/output.tsv
       The *.csproj of HSD-Unity are generated by Unity (copy them from a worktree Unity has opened). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>lvl</AssemblyName>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <UnityManaged Condition="'$(UnityManaged)' == ''">C:\Program Files\Unity\Hub\Editor\6000.6.5f1\Editor\Data\Managed</UnityManaged>
    <ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>true</ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="HSD.R5Replay"><HintPath>$(HsdBin)\HSD.R5Replay.dll</HintPath></Reference>
    <Reference Include="HSD.Game"><HintPath>$(HsdBin)\HSD.Game.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(UnityManaged)\UnityEngine\UnityEngine.CoreModule.dll</HintPath></Reference>
  </ItemGroup>
</Project>
