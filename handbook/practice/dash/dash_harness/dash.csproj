<Project Sdk="Microsoft.NET.Sdk">
  <!-- hb-slam dash harness (practice A2) (same set-up as handbook/tables/level_scale_harness). Build HSD-Unity practice/slam first (no Unity needed):
         dotnet build <HSD-Unity-SLAM>/HSD.Game.csproj -p:OutputPath=<bin>
       (the generated HSD.R5Replay.csproj must list Abilities/Dash/DashAbility.cs; Unity adds it when it opens the project)
       then: dotnet build dash.csproj -p:HsdBin=<bin> -o <out>;  dotnet <out>/dash.dll all <out>/output.tsv -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>dash</AssemblyName>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <UnityManaged Condition="'$(UnityManaged)' == ''">C:\Program Files\Unity\Hub\Editor\6000.6.5f1\Editor\Data\Managed</UnityManaged>
    <ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>true</ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="HSD.R5Replay"><HintPath>$(HsdBin)\HSD.R5Replay.dll</HintPath></Reference>
    <Reference Include="HSD.Game"><HintPath>$(HsdBin)\HSD.Game.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(UnityManaged)\UnityEngine\UnityEngine.CoreModule.dll</HintPath></Reference>
  </ItemGroup>
</Project>
