  "provenance": {
    "step": "meta",
    "t": "obs (Time() minus trial start)",
    "dt": "drv (difference of observed Time(); frames without a usercmd are merged into the next step)",
    "cmd": "obs MOVE-TRACE cmd= of the last usercmd logged at or before the frame (wall clock)",
    "n_cmds": "drv (count of MOVE-TRACE lines assigned to the frame)",
    "in_fwd": "obs GetInputAxisForward",
    "in_right": "obs GetInputAxisRight",
    "in_yaw": "obs",
    "in_pitch": "obs",
    "in_jump": "obs IsInputCommandHeld(IN_JUMP)",
    "in_duck": "obs IsInputCommandHeld(IN_DUCK)",
    "in_sprint": "obs MOVE-TRACE b= sprint bit (1<<15 in this build; see schema.BUTTON_BITS) of the step's last usercmd",
    "buttons": "obs MOVE-TRACE b=",
    "cmd_fwd": "obs MOVE-TRACE fwd=",
    "cmd_side": "obs MOVE-TRACE sd=",
    "movescale": "obs MOVE-TRACE msc=",
    "maxspeed": "obs MOVE-TRACE ms=",
    "pressed": "drv (MOVE-TRACE b= bits and fwd=/sd= signs, per usercmd, against the previous usercmd)",
    "released": "drv (as pressed)",
    "pos_x": "obs",
    "pos_y": "obs",
    "pos_z": "obs",
    "vel_x": "obs",
    "vel_y": "obs",
    "vel_z": "obs",
    "grounded": "obs",
    "sliding": "obs",
    "crouched": "obs",
    "sprinting": "obs",
    "events": "drv (hsdtel edge detection)"
  },
  "columns": {
    "step": {
      "unit": "",
      "meaning": "0-based step index within the trial"
    },
    "t": {
      "unit": "s",
      "meaning": "time at the end of the step (trial-relative, starts near 0)"
    },
    "dt": {
      "unit": "s",
      "meaning": "duration of the step"
    },
    "cmd": {
      "unit": "",
      "meaning": "usercmd command_number of the last command simulated in the step"
    },
    "n_cmds": {
      "unit": "",
      "meaning": "number of usercmds logged in the step; cmd - previous cmd must equal it"
    },
    "in_fwd": {
      "unit": "",
      "meaning": "forward input -1..1 applied during the step"
    },
    "in_right": {
      "unit": "",
      "meaning": "right input -1..1 applied during the step"
    },
    "in_yaw": {
      "unit": "deg",
      "meaning": "view yaw during the step (Source convention: + = turn left)"
    },
    "in_pitch": {
      "unit": "deg",
      "meaning": "view pitch during the step"
    },
    "in_jump": {
      "unit": "",
      "meaning": "jump held 0/1"
    },
    "in_duck": {
      "unit": "",
      "meaning": "duck held 0/1"
    },
    "in_sprint": {
      "unit": "",
      "meaning": "sprint (IN_SPEED) held 0/1 in the usercmd"
    },
    "buttons": {
      "unit": "",
      "meaning": "usercmd m_nButtons held mask (in_buttons.h bits) of the step's last command"
    },
    "cmd_fwd": {
      "unit": "",
      "meaning": "usercmd forwardmove -1..1 of the step's last command"
    },
    "cmd_side": {
      "unit": "",
      "meaning": "usercmd sidemove -1..1 (+ = right) of the step's last command"
    },
    "movescale": {
      "unit": "",
      "meaning": "m_cachedMoveScale of the step's last usercmd (weapon/ability move-speed factor); optional"
    },
    "maxspeed": {
      "unit": "u/s",
      "meaning": "CMoveData maxspeed of the step's last usercmd; optional"
    },
    "pressed": {
      "unit": "",
      "meaning": "'|'-joined inputs that went down during the step: button names, AX_FWD/AX_BACK/AX_RIGHT/AX_LEFT"
    },
    "released": {
      "unit": "",
      "meaning": "'|'-joined inputs that went up during the step (same names)"
    },
    "pos_x": {
      "unit": "u",
      "meaning": "position after the step"
    },
    "pos_y": {
      "unit": "u",
      "meaning": ""
    },
    "pos_z": {
      "unit": "u",
      "meaning": ""
    },
    "vel_x": {
      "unit": "u/s",
      "meaning": "velocity after the step"
    },
    "vel_y": {
      "unit": "u/s",
      "meaning": ""
    },
    "vel_z": {
      "unit": "u/s",
      "meaning": ""
    },
    "grounded": {
      "unit": "",
      "meaning": "1/0 after the step; empty = unknown"
    },
    "sliding": {
      "unit": "",
      "meaning": "1/0 after the step; empty = unknown"
    },
