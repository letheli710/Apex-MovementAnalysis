//=============================================================================
// HSD.MoveDiag v0.2 -- observe-only movement telemetry.
//
// Changes no movement state. Every line it prints starts with "[HSD-MD]",
// carries "ver=2" and is a list of key=value tokens with no spaces inside a
// value (an optional trailing msg= takes the rest of the line). The parser is
// research/phase2-prep/tools/hsd_tel.py; the line formats are specified in
// research/phase2-prep/TELEMETRY-SCHEMA.md.
//
//   SERVER: one line per engine movement event (AddPlayerMovementEventCallback),
//           optional per-server-frame samples (hsd_md_sv_trace 1), a settings
//           dump when hsd_md_dump_now is set to 1 on the dedi console (or on the
//           client command "hsd_md_dump"), run labels from hsd_md_run.
//   CLIENT: per-render-frame sampler of the local predicted player: takeoff and
//           landing summaries always, one line per frame with hsd_md_cl_trace 1,
//           settings dump when hsd_md_dump_now is set to 1 on the client console,
//           run labels from hsd_md_run.
//
// Static rules this file follows (research/phase2-prep/VALIDATION-REPORT.md):
//   - Every global function / constant used in a VM has a base-script use in
//     that same VM (hsd_vmcheck.py). IN_BACK, IN_MOVELEFT, IN_MOVERIGHT and
//     IN_SPEED have no CLIENT evidence, so the client uses the input axes.
//   - Every entity method call that could be missing is inside try/catch.
//   - Every SERVER callback/thread body is inside try/catch: an uncaught
//     server-VM error schedules HS_GAME_SHUTDOWN (s21-r5sdk/AGENTS.md:202).
//
// NOT RUN: compiled and executed nowhere yet.
//=============================================================================

#if SERVER
global function CodeCallback_HSD_MoveDiag_ModInit
#endif // SERVER

#if CLIENT
global function ClientCodeCallback_HSD_MoveDiag_ModInit
#endif // CLIENT

const string HSD_MD_TAG = "[HSD-MD] ver=2"

// Keys proven to exist somewhere in the class-var/settings surface:
// sh_surf_movement.gnut:5-21, gameui/IClassVarLab.cpp:29-54, cfg/speed.cfg,
// game/server/wallclimb.cpp:44-65, game/server/slide_super_jump.cpp:5-8.
// A key the settings block lacks is reported as vtype=ERR, not fatal.
const array<string> HSD_MD_SETTINGS_KEYS = [
	"speed", "sprintspeed", "acceleration", "deceleration", "lowSpeed", "lowAcceleration",
	"sprintAcceleration", "sprintDeceleration",
	"gravityScale", "jumpHeight", "stepHeight",
	"airSpeed", "airAcceleration", "airFriction", "airDrag",
	"doubleJump", "superjumpMinHeight", "superjumpMaxHeight", "superjumpHorzSpeed", "superjumpLimit",
	"slideAccel", "slideDecel", "slideVelocityDecay", "slideRequiredStartSpeed", "slideSpeedBoost",
	"slideSpeedBoostCap", "slideJumpHeight", "slideMaxJumpSpeed", "slideStopSpeed", "slideMaxStopSpeed",
	"slideWantToStopDecel", "slideSuperJumpHeight", "slideSuperJumpCooldown",
	"sprintStartDelay", "sprintStartDuration", "sprintStartFastDuration", "sprintEndDuration",
	"speedScaleSide", "speedScaleBack", "landSlowdownDuration", "antiMultiJumpHeightFrac",
	"mantleAngleScale", "climbEnabled", "climbHeight", "climbFinalJumpUpHeight", "climbSpeedStart",
	"wallrun", "wallrun_timeLimit", "wallrun_hangTimeLimit", "wallrunAccelerateHorizontal",
	"wallrunAccelerateVertical", "wallrunMaxSpeedHorizontal", "wallrunMaxSpeedVertical",
	"wallrunJumpOutwardSpeed", "wallrunJumpUpSpeed", "wallrunJumpInputDirSpeed",
	"dodgeSpeed", "dodgeDuration",
]

struct
{
	bool inited
	int seq
	int run
	int errors
#if SERVER
	table<entity, bool> hooked
	bool watcherStarted
#endif // SERVER
} file

//-----------------------------------------------------------------------------
// Shared helpers
//-----------------------------------------------------------------------------
int function HSD_MD_ConVarInt( string name, int fallback )
{
	try
	{
		return GetConVarInt( name )
	}
	catch ( eConVar )
	{
	}
	return fallback
}

bool function HSD_MD_Enabled()
{
	return HSD_MD_ConVarInt( "hsd_md_enable", 1 ) != 0
}

// Line prefix shared by every record: tag, side, kind, run label, line counter.
string function HSD_MD_Head( string side, string kind )
{
	file.seq++
	return format( "%s side=%s kind=%s run=%d seq=%d", HSD_MD_TAG, side, kind, file.run, file.seq )
}

// Contained failure report. msg= is last: the parser takes the rest of the line.
// Callers convert the caught value with string( e ) inside their catch block,
// the same pattern as ai/_ai_utility.gnut:781-783.
void function HSD_MD_Error( string side, string where, string text )
{
	file.errors++
	if ( file.errors > 50 )
		return
	printt( format( "%s where=%s count=%d msg=%s", HSD_MD_Head( side, "error" ), where, file.errors, text ) )
}

// -1 = the method was not available or threw (never a real state).
int function HSD_MD_OnGround( entity player )
{
	try
	{
		return player.IsOnGround() ? 1 : 0
	}
	catch ( eGround )
	{
	}
	return -1
}

int function HSD_MD_Sliding( entity player )
{
	try
	{
		return player.IsSliding() ? 1 : 0
	}
	catch ( eSlide )
	{
	}
	return -1
}

int function HSD_MD_Sprinting( entity player )
{
	try
	{
		return player.IsSprinting() ? 1 : 0
	}
	catch ( eSprint )
	{
	}
	return -1
}

int function HSD_MD_Crouched( entity player )
{
	try
	{
		return player.IsCrouched() ? 1 : 0
	}
	catch ( eCrouch )
	{
	}
	return -1
}

int function HSD_MD_EntIndex( entity player )
{
	try
	{
		return player.GetEntIndex()
	}
	catch ( eIndex )
	{
	}
	return -1
}

// Observed kinematics + state flags. Names match TELEMETRY-SCHEMA.md.
string function HSD_MD_StateTokens( entity player )
{
	vector vel = player.GetVelocity()
	vector org = player.GetOrigin()
	return format( "o=%.3f,%.3f,%.3f vel=%.3f,%.3f,%.3f spd2d=%.3f vz=%.3f ground=%d slide=%d sprint=%d crouch=%d",
		org.x, org.y, org.z, vel.x, vel.y, vel.z, Length2D( vel ), vel.z,
		HSD_MD_OnGround( player ), HSD_MD_Sliding( player ), HSD_MD_Sprinting( player ), HSD_MD_Crouched( player ) )
}

// hsd_md_run is a plain integer label typed on each console before a trial.
void function HSD_MD_PollRun( string side )
{
	int run = HSD_MD_ConVarInt( "hsd_md_run", 0 )
	if ( run == file.run )
		return
	int prev = file.run
	file.run = run
	printt( format( "%s prev=%d t=%.5f", HSD_MD_Head( side, "run" ), prev, Time() ) )
}

// Values are read with the typed getters the base scripts use. Bool fields have
// no base getter (GetPlayerSettingBool has no use anywhere), so a bool key is
// expected to come back through Int or as ERR.
void function HSD_MD_DumpSettings( string side, entity player )
{
	int nOk = 0
	foreach ( string key in HSD_MD_SETTINGS_KEYS )
	{
		string value = ""
		string vtype = "ERR"
		try
		{
			value = format( "%.6f", player.GetPlayerSettingFloat( key ) )
			vtype = "float"
		}
		catch ( eFloat )
		{
		}
#if SERVER
		// GetPlayerSettingInt has a SERVER use only (mp_ability_holopilot.nut:571).
		if ( vtype == "ERR" )
		{
			try
			{
				value = format( "%d", player.GetPlayerSettingInt( key ) )
				vtype = "int"
			}
			catch ( eInt )
			{
			}
		}
#endif // SERVER
		if ( vtype == "ERR" )
		{
			try
			{
				value = player.GetPlayerSettingString( key )
				vtype = "string"
			}
			catch ( eString )
			{
			}
		}
		if ( vtype != "ERR" )
			nOk++
		printt( format( "%s ent=%d key=%s vtype=%s value=%s", HSD_MD_Head( side, "setting" ),
			HSD_MD_EntIndex( player ), key, vtype, value == "" ? "-" : value ) )
	}
	printt( format( "%s ent=%d ok=%d total=%d", HSD_MD_Head( side, "dump" ),
		HSD_MD_EntIndex( player ), nOk, HSD_MD_SETTINGS_KEYS.len() ) )
}

//=============================================================================
// SERVER
//=============================================================================
#if SERVER
void function CodeCallback_HSD_MoveDiag_ModInit()
{
	// Reached once per level per VM: from SV_CL_Init on maps and from
	// Shared_Lobby_Init in the lobby (_sh_init.gnut:30-43,91,990). Guarded anyway.
	if ( file.inited )
		return
	file.inited = true

	try
	{
		if ( IsLobby() )
			return

		AddCallback_OnPlayerRespawned( HSD_MD_OnPlayerRespawned )
		AddClientCommandCallback( "hsd_md_dump", HSD_MD_ClientCommand_Dump )
		AddClientCommandCallback( "hsd_md_mark", HSD_MD_ClientCommand_Mark )
		printt( HSD_MD_Head( "sv", "init" ) + " mod=0.2.0" )
	}
	catch ( eInit )
	{
		HSD_MD_Error( "sv", "init", string( eInit ) )
	}
}

void function HSD_MD_OnPlayerRespawned( entity player )
{
	try
	{
		if ( !IsValid( player ) || !player.IsPlayer() )
			return

		// The movement-event table lives on the player entity and survives a
		// respawn; AddPlayerMovementEventCallback asserts on a second add
		// (_codecallbacks_common.gnut:958-970).
		if ( !( player in file.hooked ) )
		{
			file.hooked[ player ] <- true
			AddPlayerMovementEventCallback( player, ePlayerMovementEvents.JUMP, HSD_MD_OnJump )
			AddPlayerMovementEventCallback( player, ePlayerMovementEvents.DOUBLE_JUMP, HSD_MD_OnDoubleJump )
			AddPlayerMovementEventCallback( player, ePlayerMovementEvents.DODGE, HSD_MD_OnDodge )
			AddPlayerMovementEventCallback( player, ePlayerMovementEvents.LEAVE_GROUND, HSD_MD_OnLeaveGround )
			AddPlayerMovementEventCallback( player, ePlayerMovementEvents.TOUCH_GROUND, HSD_MD_OnTouchGround )
			AddPlayerMovementEventCallback( player, ePlayerMovementEvents.MANTLE, HSD_MD_OnMantle )
			AddPlayerMovementEventCallback( player, ePlayerMovementEvents.BEGIN_WALLRUN, HSD_MD_OnBeginWallrun )
			AddPlayerMovementEventCallback( player, ePlayerMovementEvents.END_WALLRUN, HSD_MD_OnEndWallrun )
			AddPlayerMovementEventCallback( player, ePlayerMovementEvents.BEGIN_WALLHANG, HSD_MD_OnBeginWallhang )
			AddPlayerMovementEventCallback( player, ePlayerMovementEvents.END_WALLHANG, HSD_MD_OnEndWallhang )
			AddPlayerMovementEventCallback( player, ePlayerMovementEvents.BEGIN_SLIDE, HSD_MD_OnBeginSlide )
			AddPlayerMovementEventCallback( player, ePlayerMovementEvents.END_SLIDE, HSD_MD_OnEndSlide )
			thread HSD_MD_ServerSample_Thread( player )
		}

		if ( !file.watcherStarted )
		{
			file.watcherStarted = true
			thread HSD_MD_ServerWatch_Thread()
		}

		HSD_MD_LogEvent( player, "RESPAWN" )
	}
	catch ( eSpawn )
	{
		HSD_MD_Error( "sv", "respawn", string( eSpawn ) )
	}
}

void function HSD_MD_LogEvent( entity player, string eventName )
{
	try
	{
		if ( !HSD_MD_Enabled() || !IsValid( player ) )
			return
		printt( format( "%s evt=%s t=%.5f ent=%d bot=%d %s", HSD_MD_Head( "sv", "evt" ), eventName, Time(),
			HSD_MD_EntIndex( player ), player.IsBot() ? 1 : 0, HSD_MD_StateTokens( player ) ) )
	}
	catch ( eEvt )
	{
		HSD_MD_Error( "sv", "evt_" + eventName, string( eEvt ) )
	}
}

void function HSD_MD_OnJump( entity player ) { HSD_MD_LogEvent( player, "JUMP" ) }
void function HSD_MD_OnDoubleJump( entity player ) { HSD_MD_LogEvent( player, "DOUBLE_JUMP" ) }
void function HSD_MD_OnDodge( entity player ) { HSD_MD_LogEvent( player, "DODGE" ) }
void function HSD_MD_OnLeaveGround( entity player ) { HSD_MD_LogEvent( player, "LEAVE_GROUND" ) }
void function HSD_MD_OnTouchGround( entity player ) { HSD_MD_LogEvent( player, "TOUCH_GROUND" ) }
void function HSD_MD_OnMantle( entity player ) { HSD_MD_LogEvent( player, "MANTLE" ) }
void function HSD_MD_OnBeginWallrun( entity player ) { HSD_MD_LogEvent( player, "BEGIN_WALLRUN" ) }
void function HSD_MD_OnEndWallrun( entity player ) { HSD_MD_LogEvent( player, "END_WALLRUN" ) }
void function HSD_MD_OnBeginWallhang( entity player ) { HSD_MD_LogEvent( player, "BEGIN_WALLHANG" ) }
void function HSD_MD_OnEndWallhang( entity player ) { HSD_MD_LogEvent( player, "END_WALLHANG" ) }
void function HSD_MD_OnBeginSlide( entity player ) { HSD_MD_LogEvent( player, "BEGIN_SLIDE" ) }
void function HSD_MD_OnEndSlide( entity player ) { HSD_MD_LogEvent( player, "END_SLIDE" ) }

// Server frames only (base_tickinterval_mp 0.05 -> 20 Hz). One server frame can
// run several usercmds, so this is a coarse view; per-command data comes from
// the SDK's bridge_move_trace.
void function HSD_MD_ServerSample_Thread( entity player )
{
	player.EndSignal( "OnDestroy" )

	while ( true )
	{
		WaitFrame()
		try
		{
			if ( !IsValid( player ) )
				return
			if ( HSD_MD_ConVarInt( "hsd_md_sv_trace", 0 ) == 0 || !HSD_MD_Enabled() || !IsAlive( player ) )
				continue
			printt( format( "%s t=%.5f ft=%.5f ent=%d bot=%d %s", HSD_MD_Head( "sv", "frame" ), Time(), FrameTime(),
				HSD_MD_EntIndex( player ), player.IsBot() ? 1 : 0, HSD_MD_StateTokens( player ) ) )
		}
		catch ( eSample )
		{
			HSD_MD_Error( "sv", "sample", string( eSample ) )
		}
	}
}

// Dedi-console levers that need no client->server command routing:
// hsd_md_run <n> labels the following lines, hsd_md_dump_now 1 dumps every
// player's settings once and resets itself to 0.
void function HSD_MD_ServerWatch_Thread()
{
	while ( true )
	{
		WaitFrame()
		try
		{
			HSD_MD_PollRun( "sv" )
			if ( HSD_MD_ConVarInt( "hsd_md_dump_now", 0 ) == 0 )
				continue
			SetConVarInt( "hsd_md_dump_now", 0 )
			foreach ( entity player in GetPlayerArray() )
			{
				if ( IsValid( player ) )
					HSD_MD_DumpSettings( "sv", player )
			}
		}
		catch ( eWatch )
		{
			HSD_MD_Error( "sv", "watch", string( eWatch ) )
		}
	}
}

// "hsd_md_mark <label>" -- labelled line for cutting trials apart. Reaching the
// server from the client console is unverified (see LOCAL-SETUP.md).
void function HSD_MD_ClientCommand_Mark( entity player, array<string> args )
{
	try
	{
		if ( !IsValid( player ) || !player.IsPlayer() )
			return
		string label = args.len() > 0 ? args[0] : "mark"
		printt( format( "%s t=%.5f ent=%d label=%s %s", HSD_MD_Head( "sv", "mark" ), Time(),
			HSD_MD_EntIndex( player ), label, HSD_MD_StateTokens( player ) ) )
	}
	catch ( eMark )
	{
		HSD_MD_Error( "sv", "mark", string( eMark ) )
	}
}

// "hsd_md_dump" -- the settings values the server reads for this player, plus
// a CSV through DevTextBufferDumpToFile. That native has an unguarded SERVER
// use (survival_loot.gnut:8538); the SDK keeps only the base name and prefixes
// "scriptdump_" (vscript/script_convar_guard.cpp:300-341).
void function HSD_MD_ClientCommand_Dump( entity player, array<string> args )
{
	try
	{
		if ( !IsValid( player ) || !player.IsPlayer() )
			return
		HSD_MD_DumpSettings( "sv", player )

		DevTextBufferClear()
		DevTextBufferWrite( "key,float_value\n" )
		foreach ( string key in HSD_MD_SETTINGS_KEYS )
		{
			string value = "ERR"
			try
			{
				value = format( "%.6f", player.GetPlayerSettingFloat( key ) )
			}
			catch ( eCsv )
			{
			}
			DevTextBufferWrite( key + "," + value + "\n" )
		}
		bool dumped = DevTextBufferDumpToFile( "hsd_movediag_settings.csv" )
		printt( format( "%s file=%d", HSD_MD_Head( "sv", "dumpfile" ), dumped ? 1 : 0 ) )
	}
	catch ( eDump )
	{
		HSD_MD_Error( "sv", "dump", string( eDump ) )
	}
}
#endif // SERVER

//=============================================================================
// CLIENT
//=============================================================================
#if CLIENT
void function ClientCodeCallback_HSD_MoveDiag_ModInit()
{
	if ( file.inited )
		return
	file.inited = true

	if ( IsLobby() )
		return

	// Started directly from init like SurfMovement_ApplyWhenReady_THREAD
	// (sh_surf_movement.gnut:77), so it never depends on spawn-callback order;
	// the loop idles until a live local player exists.
	thread HSD_MD_ClientSample_Thread()
	printt( HSD_MD_Head( "cl", "init" ) + " mod=0.2.0" )
}

int function HSD_MD_InputHeld( entity player, int button )
{
	try
	{
		return player.IsInputCommandHeld( button ) ? 1 : 0
	}
	catch ( eInput )
	{
	}
	return -1
}

float function HSD_MD_Axis( entity player, bool forward )
{
	try
	{
		return forward ? player.GetInputAxisForward() : player.GetInputAxisRight()
	}
	catch ( eAxis )
	{
	}
	return -9.0
}

// View angles as "pitch,yaw"; the base builds a move intention from the input
// axes rotated by EyeAngles().y (sh_doors.nut:1577-1580).
string function HSD_MD_Angles( entity player )
{
	try
	{
		vector ang = player.EyeAngles()
		return format( "%.3f,%.3f", ang.x, ang.y )
	}
	catch ( eAngles )
	{
	}
	return "nan,nan"
}

// Camera tokens for the frame line (rea-native C3): rendered camera position and
// angles, eye position and angles, the aim vector and the FOV, so view punch,
// tilt, eye height and FOV changes can be compared with the aim direction.
string function HSD_MD_CameraTokens( entity player )
{
	try
	{
		vector cp = player.CameraPosition()
		vector ca = player.CameraAngles()
		vector ep = player.EyePosition()
		vector ea = player.EyeAngles()
		vector vv = player.GetViewVector()
		return format( "cpos=%.3f,%.3f,%.3f cang=%.4f,%.4f,%.4f epos=%.3f,%.3f,%.3f eang=%.4f,%.4f,%.4f vv=%.5f,%.5f,%.5f fov=%.3f",
			cp.x, cp.y, cp.z, ca.x, ca.y, ca.z, ep.x, ep.y, ep.z, ea.x, ea.y, ea.z, vv.x, vv.y, vv.z, player.GetFOV() )
	}
	catch ( eCamera )
	{
	}
	return "cpos=nan"
}

// Samples the predicted local player once per client frame. Edges are found on
// the sampled ground flag, so an airtime shorter than one frame is invisible.
void function HSD_MD_ClientSample_Thread()
{
	int prevGround = -1
	float airStart = 0.0
	float takeoffSpeed = 0.0
	float peakSpeed = 0.0
	float groundStart = 0.0
	int hops = 0

	while ( true )
	{
		WaitFrame()
		try
		{
			HSD_MD_PollRun( "cl" )

			entity player = GetLocalClientPlayer()
			if ( !IsValid( player ) || !player.IsPlayer() || !IsAlive( player ) || !HSD_MD_Enabled() )
			{
				prevGround = -1
				continue
			}

			if ( HSD_MD_ConVarInt( "hsd_md_dump_now", 0 ) != 0 )
			{
				SetConVarInt( "hsd_md_dump_now", 0 )
				HSD_MD_DumpSettings( "cl", player )
			}

			float now = Time()
			vector vel = player.GetVelocity()
			float spd = Length2D( vel )
			int ground = HSD_MD_OnGround( player )

			if ( HSD_MD_ConVarInt( "hsd_md_cl_trace", 0 ) != 0 )
			{
				printt( format( "%s t=%.5f ft=%.5f %s ang=%s in_jump=%d in_duck=%d in_fwd=%d ax_fwd=%.3f ax_right=%.3f %s",
					HSD_MD_Head( "cl", "frame" ), now, FrameTime(), HSD_MD_StateTokens( player ), HSD_MD_Angles( player ),
					HSD_MD_InputHeld( player, IN_JUMP ), HSD_MD_InputHeld( player, IN_DUCK ),
					HSD_MD_InputHeld( player, IN_FORWARD ),
					HSD_MD_Axis( player, true ), HSD_MD_Axis( player, false ), HSD_MD_CameraTokens( player ) ) )
			}

			if ( ground == 0 && spd > peakSpeed )
				peakSpeed = spd

			if ( prevGround == 1 && ground == 0 )
			{
				// Ground contact shorter than 0.1 s between two airtimes counts as a hop chain.
				float groundTime = now - groundStart
				hops = ( groundTime < 0.1 ) ? hops + 1 : 0
				airStart = now
				takeoffSpeed = spd
				peakSpeed = spd
				printt( format( "%s t=%.5f groundtime=%.4f hop=%d %s", HSD_MD_Head( "cl", "takeoff" ),
					now, groundTime, hops, HSD_MD_StateTokens( player ) ) )
			}
			else if ( prevGround == 0 && ground == 1 )
			{
				groundStart = now
				printt( format( "%s t=%.5f airtime=%.4f takeoff=%.3f peak=%.3f land=%.3f gain=%.3f hop=%d %s",
					HSD_MD_Head( "cl", "land" ), now, now - airStart, takeoffSpeed, peakSpeed, spd,
					spd - takeoffSpeed, hops, HSD_MD_StateTokens( player ) ) )
			}
			else if ( prevGround == -1 && ground == 1 )
			{
				groundStart = now
			}

			prevGround = ground
		}
		catch ( eClient )
		{
			HSD_MD_Error( "cl", "sample", string( eClient ) )
		}
	}
}
#endif // CLIENT
