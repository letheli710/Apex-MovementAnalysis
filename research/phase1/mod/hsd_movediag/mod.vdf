"ModSystem"
{
	"name"			"HSD Movement Diagnostic"
	"id"			"HSD.MoveDiag"
	"author"		"High Speed Doom research"
	"description"	"Observe-only movement telemetry: server movement events, client per-frame predicted state, live player-settings dump, run labels. Changes no movement."
	"version"		"0.2.0"
	"realm"			"both"

	// Each enabled mod registers these on its own engine in Activate()
	// (s21-r5sdk/src/pluginsystem/modsystem.cpp:771-773,1043-1137); a name that
	// already exists is skipped. Flag names are the FCVAR_ suffixes of
	// tier1/cvar.cpp:12-53 and are case-sensitive ("RELEASE", not "release").
	// Scripts read them through try/catch and fall back to the defaults below.
	"ConVars"
	{
		"hsd_md_enable"
		{
			"helpText"	"[HSD-MD] master enable for the movement telemetry mod (observe only)."
			"flags"		"RELEASE"
			"Values"
			{
				"default"	"1"
				"min"		"0"
				"max"		"1"
			}
		}
		"hsd_md_cl_trace"
		{
			"helpText"	"[HSD-MD] client: 1 = one line per client frame (high volume), 0 = takeoff/landing summaries only."
			"flags"		"RELEASE"
			"Values"
			{
				"default"	"0"
				"min"		"0"
				"max"		"1"
			}
		}
		"hsd_md_sv_trace"
		{
			"helpText"	"[HSD-MD] server: 1 = one line per server frame per player (20 Hz at base_tickinterval_mp 0.05)."
			"flags"		"RELEASE"
			"Values"
			{
				"default"	"0"
				"min"		"0"
				"max"		"1"
			}
		}
		"hsd_md_run"
		{
			"helpText"	"[HSD-MD] integer trial label copied into every line (run=). Set the same value on client and dedi before each trial."
			"flags"		"RELEASE"
			"Values"
			{
				"default"	"0"
				"min"		"0"
				"max"		"999999"
			}
		}
		"hsd_md_dump_now"
		{
			"helpText"	"[HSD-MD] set to 1 to print the player-settings values once on this engine; resets itself to 0."
			"flags"		"RELEASE"
			"Values"
			{
				"default"	"0"
				"min"		"0"
				"max"		"1"
			}
		}
	}
}
